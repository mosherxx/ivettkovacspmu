# PBKDF2 hash of the one-time initial admin password. Configure through Sites secrets.
# Existing accounts keep their saved password when this value changes.
ADMIN_INITIAL_HASH=

# Optional DeepL API key, configured as a hosted secret. Blank disables automatic translation.
DEEPL_API_KEY=

# Transactional reservation emails. Use an active Resend API key and a sender
# address on the verified ivettkovacspmu.hu domain.
RESEND_API_KEY=
RESEND_FROM=Ivett Kovacs PMU <foglalas@ivettkovacspmu.hu>

# Recovery recipient is separate from public/editable contact info.
ADMIN_RECOVERY_EMAIL=

# Exact browser origin for recovery links and origin validation (Sites or Docker).
# Set https://your-domain.hu behind your HTTPS reverse proxy.
PUBLIC_ORIGIN=

# Docker Cloudflare Tunnel token for compose.tunnel.yaml. Keep it private.
TUNNEL_TOKEN=
